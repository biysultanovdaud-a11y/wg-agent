# Copy to .env on the node — never commit the real file.

PORT=8787
HOST=0.0.0.0

# Generate with: openssl rand -hex 32
API_KEY=

WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
WG_SUBNET_CIDR=10.8.0.0/24

# Public hostname or IP clients connect to — goes into every issued
# client config's [Peer] Endpoint. Required; there is no sensible default.
WG_ENDPOINT_HOST=

WG_ENDPOINT_PORT=51820
WG_CLIENT_DNS=1.1.1.1, 1.0.0.1
WG_CLIENT_KEEPALIVE=25

LOG_LEVEL=info
NODE_ENV=production
